            </defs>
            <!-- Backdrop -->
            <rect width="360" height="360" fill="url(#webGrad)"/>

            <!-- Web layout mockup (left) -->
            <g transform="translate(30, 40)">
              <rect x="0" y="0" width="150" height="106" rx="6" fill="#ffffff" stroke="#1a1d24" stroke-width="1"/>
              <rect x="0" y="0" width="150" height="22" rx="6" fill="#1a1d24"/>
              <circle cx="10" cy="11" r="2.5" fill="#ff6b6b"/>
              <circle cx="20" cy="11" r="2.5" fill="#ffd166"/>
              <circle cx="30" cy="11" r="2.5" fill="#06d6a0"/>
