              <path d="M 75 22 L 60 36 L 56 70 L 48 130 L 102 130 L 94 70 L 90 36 Z" fill="#1a1d24"/>
              <!-- Pattern -->
              <g opacity="0.7">
                <circle cx="64" cy="60" r="3" fill="#f3b13a"/>
                <circle cx="82" cy="78" r="3" fill="#f3b13a"/>
                <circle cx="70" cy="92" r="3" fill="#f3b13a"/>
                <circle cx="86" cy="110" r="3" fill="#f3b13a"/>
                <circle cx="76" cy="50" r="2" fill="#ffffff"/>
                <circle cx="80" cy="100" r="2" fill="#ffffff"/>
              </g>
              <!-- Tag -->
              <rect x="110" y="14" width="32" height="16" rx="2" fill="#f5f0e3" stroke="#1a1d24" stroke-width="0.5"/>
              <line x1="118" y1="20" x2="134" y2="20" stroke="#1a1d24" stroke-width="0.5"/>
              <line x1="118" y1="24" x2="128" y2="24" stroke="#1a1d24" stroke-width="0.5"/>
              <text x="76" y="150" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5b6168" letter-spacing="1">DESIGN · v3</text>
              <!-- AI badge -->
              <rect x="115" y="-10" width="36" height="18" rx="9" fill="#00d4a8"/>
              <text x="133" y="2" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#0c0e12">AI · WEAR</text>
            </g>

            <!-- Side panel (right bottom) -->
            <g transform="translate(200, 170)">
              <rect x="0" y="0" width="130" height="160" rx="6" fill="#1a1d24"/>
              <text x="12" y="20" font-family="'JetBrains Mono', monospace" font-size="8" fill="#a8aaa3" letter-spacing="1">UMX · TEMPLATES</text>
              <text x="12" y="36" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#ecece5">238</text>
              <text x="36" y="36" font-family="'JetBrains Mono', monospace" font-size="8" fill="#a8aaa3">模板</text>
              <!-- Mini bars -->
              <g>
                <rect x="12" y="48" width="80" height="4" rx="2" fill="#4a5cff"/>
                <rect x="12" y="56" width="50" height="4" rx="2" fill="#7c5cff"/>
                <rect x="12" y="64" width="96" height="4" rx="2" fill="#00d4a8"/>
                <rect x="12" y="72" width="62" height="4" rx="2" fill="#f3b13a"/>
                <rect x="12" y="80" width="40" height="4" rx="2" fill="#4a5cff"/>
              </g>
              <!-- Stat -->
              <text x="12" y="108" font-family="'JetBrains Mono', monospace" font-size="8" fill="#a8aaa3" letter-spacing="1">AVG · TURNAROUND</text>
              <text x="12" y="128" font-family="Inter, sans-serif" font-size="22" font-weight="500" fill="#ecece5">3 min</text>
              <text x="12" y="146" font-family="'JetBrains Mono', monospace" font-size="8" fill="#a8aaa3">≈ 行业 1/40</text>
