              <rect x="14" y="14" width="40" height="22" fill="#4a5cff" opacity="0.65"/>
              <circle cx="80" cy="78" r="10" fill="#00d4a8" opacity="0.7"/>
              <rect x="90" y="68" width="28" height="28" fill="#f3b13a" opacity="0.75"/>
              <!-- AI badge -->
              <rect x="95" y="-10" width="36" height="18" rx="9" fill="#7c5cff"/>
              <text x="113" y="2" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#ffffff">AI · SPACE</text>
            </g>

            <!-- Fashion design (bottom left) -->
            <g transform="translate(30, 170)">
              <rect x="0" y="0" width="150" height="160" rx="6" fill="#ffffff" stroke="#1a1d24" stroke-width="1"/>
