              <rect x="90" y="80" width="50" height="18" rx="3" fill="#1a1d24"/>
              <!-- AI badge -->
              <rect x="115" y="-10" width="36" height="18" rx="9" fill="#f3b13a"/>
              <text x="133" y="2" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#0c0e12">AI · WEB</text>
            </g>

            <!-- Floor plan / interior (right top) -->
            <g transform="translate(200, 40)">
              <rect x="0" y="0" width="130" height="106" rx="6" fill="#ffffff" stroke="#1a1d24" stroke-width="1"/>
              <rect x="6" y="6" width="118" height="94" fill="#f5f0e3"/>
              <!-- Walls -->
              <g stroke="#1a1d24" stroke-width="1.4" fill="none">
                <rect x="6" y="6" width="118" height="94"/>
                <line x1="60" y1="6" x2="60" y2="60"/>
                <line x1="6" y1="60" x2="60" y2="60"/>
                <line x1="80" y1="60" x2="80" y2="100"/>
              </g>
