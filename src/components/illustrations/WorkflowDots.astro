---
// 暗调工作室 — 工作流节点 + 漏斗数据示意
---

<svg viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="flowLine" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#4a5cff"/>
                <stop offset="50%" stop-color="#7c5cff"/>
                <stop offset="100%" stop-color="#00d4a8"/>
              </linearGradient>
            </defs>
            <rect width="400" height="220" fill="#f6f6f1"/>
            <!-- Grid -->
            <g opacity="0.1" stroke="#0c0e12" stroke-width="0.5">
              <line x1="50" y1="20" x2="50" y2="200"/>
              <line x1="125" y1="20" x2="125" y2="200"/>
              <line x1="200" y1="20" x2="200" y2="200"/>
              <line x1="275" y1="20" x2="275" y2="200"/>
              <line x1="350" y1="20" x2="350" y2="200"/>
            </g>
            <!-- Flow path -->
            <path d="M 30 110 C 70 110, 90 60, 130 60 C 170 60, 180 110, 220 110 C 260 110, 270 160, 310 160 C 340 160, 350 110, 380 110" fill="none" stroke="url(#flowLine)" stroke-width="2.5" stroke-dasharray="3 3"/>
            <!-- Nodes -->
            <g>
              <circle cx="30" cy="110" r="8" fill="#4a5cff"/>
              <text x="30" y="135" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#0c0e12" letter-spacing="0.5">需求</text>
              <circle cx="130" cy="60" r="8" fill="#7c5cff"/>
              <text x="130" y="44" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#0c0e12" letter-spacing="0.5">建模</text>
              <circle cx="220" cy="110" r="8" fill="#00d4a8"/>
              <text x="220" y="135" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#0c0e12" letter-spacing="0.5">验证</text>
              <circle cx="310" cy="160" r="8" fill="#f3b13a"/>
              <text x="310" y="185" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#0c0e12" letter-spacing="0.5">上线</text>
              <circle cx="380" cy="110" r="8" fill="#0c0e12"/>
              <text x="380" y="135" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#0c0e12" letter-spacing="0.5">迭代</text>
            </g>
            <!-- Top labels -->
            <g font-family="'JetBrains Mono', monospace" font-size="8" fill="#5b6168" letter-spacing="1">
              <text x="20" y="20">UMX · WORKFLOW</text>
              <text x="380" y="20" text-anchor="end">v1.0 · 2026</text>
            </g>
            <!-- Stats panel -->
            <g transform="translate(20, 170)">
              <rect width="80" height="36" rx="5" fill="#ffffff" stroke="#1a1d24" stroke-width="0.5"/>
              <text x="40" y="14" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5b6168" letter-spacing="0.5">LEAD TIME</text>
              <text x="40" y="28" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#0c0e12">2—6 周</text>
            </g>
            <g transform="translate(110, 170)">
              <rect width="80" height="36" rx="5" fill="#ffffff" stroke="#1a1d24" stroke-width="0.5"/>
              <text x="40" y="14" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5b6168" letter-spacing="0.5">FIXED COST</text>
              <text x="40" y="28" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#0c0e12">≈ 0</text>
            </g>
          </svg>
