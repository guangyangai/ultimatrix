---
// 极智短剧 — AI 场记板 + 数字人神经网络层
---

<svg viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="clapperGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#1a1d24"/>
                <stop offset="100%" stop-color="#0c0e12"/>
              </linearGradient>
              <linearGradient id="stripGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#1a1d24"/>
                <stop offset="50%" stop-color="#ffffff"/>
                <stop offset="100%" stop-color="#1a1d24"/>
              </linearGradient>
            </defs>
            <!-- Floor shadow -->
            <ellipse cx="180" cy="320" rx="130" ry="14" fill="#0c0e12" opacity="0.18"/>
            <!-- Clapper body -->
            <g transform="translate(180, 180)">
              <!-- Base bar (bottom half - solid) -->
              <rect x="-130" y="-10" width="260" height="140" rx="10" fill="url(#clapperGrad)"/>
              <!-- Hinge -->
              <rect x="-130" y="-2" width="260" height="6" fill="#4a5cff" opacity="0.7"/>
              <!-- Top bar (clapper - striped) -->
              <g transform="translate(0, -90) rotate(-8)">
                <rect x="-130" y="-25" width="260" height="50" rx="6" fill="url(#clapperGrad)"/>
                <!-- Stripes -->
                <g>
                  <rect x="-128" y="-23" width="32" height="46" fill="url(#stripGrad)"/>
                  <rect x="-64" y="-23" width="32" height="46" fill="url(#stripGrad)"/>
                  <rect x="0" y="-23" width="32" height="46" fill="url(#stripGrad)"/>
                  <rect x="64" y="-23" width="32" height="46" fill="url(#stripGrad)"/>
                </g>
                <!-- AI label -->
                <rect x="-30" y="-12" width="60" height="24" rx="4" fill="#f3b13a"/>
                <text x="0" y="4" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600" fill="#0c0e12">AI</text>
              </g>
              <!-- Label on body -->
              <text x="-110" y="60" font-family="'JetBrains Mono', monospace" font-size="10" fill="#a8aaa3" letter-spacing="2">SCENE 01 / TAKE 03</text>
              <text x="-110" y="80" font-family="'JetBrains Mono', monospace" font-size="10" fill="#a8aaa3" letter-spacing="2">RUNTIME 00:48</text>
              <!-- Status dot -->
              <circle cx="115" cy="60" r="4" fill="#00d4a8"/>
              <text x="100" y="80" text-anchor="end" font-family="'JetBrains Mono', monospace" font-size="9" fill="#00d4a8">REC</text>
            </g>
            <!-- Neural pattern overlay (subtle) -->
            <g opacity="0.25" stroke="#4a5cff" stroke-width="0.5" fill="none">
              <circle cx="60" cy="60" r="2"/>
              <circle cx="60" cy="60" r="12"/>
              <circle cx="300" cy="60" r="2"/>
              <circle cx="300" cy="60" r="14"/>
              <line x1="60" y1="60" x2="300" y2="60" stroke-dasharray="2 3"/>
              <circle cx="60" cy="300" r="2"/>
              <circle cx="300" cy="300" r="2"/>
              <line x1="60" y1="300" x2="300" y2="300" stroke-dasharray="2 3"/>
            </g>
            <!-- Top label -->
            <text x="20" y="22" font-family="'JetBrains Mono', monospace" font-size="8" fill="#5b6168" letter-spacing="1">AI · DRAMA · PIPELINE</text>
          </svg>
