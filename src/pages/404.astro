---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面未找到 · 极智矩阵" description="你访问的页面不存在。">
  <main>
    <section class="page-shell intro-shell">
      <div class="section-kicker">
        <span>404 · NOT FOUND</span>
        <span>页面不存在</span>
      </div>

      <article class="hero-card not-found-card">
        <div class="card-label"><span>错误</span><span>ERROR 404</span></div>

        <div class="not-found-body">
          <div class="not-found-scene" aria-hidden="true">
            <svg viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="lostGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#4a5cff"/>
                  <stop offset="100%" stop-color="#7c5cff"/>
                </linearGradient>
              </defs>
              <g opacity="0.1" stroke="#0c0e12" stroke-width="0.5">
                <line x1="0" y1="50" x2="400" y2="50"/>
                <line x1="0" y1="100" x2="400" y2="100"/>
                <line x1="0" y1="150" x2="400" y2="150"/>
                <line x1="100" y1="0" x2="100" y2="200"/>
                <line x1="200" y1="0" x2="200" y2="200"/>
                <line x1="300" y1="0" x2="300" y2="200"/>
              </g>
              <text x="200" y="135" text-anchor="middle"
                font-family="ui-monospace, monospace"
                font-size="100" font-weight="500"
                fill="url(#lostGrad)" letter-spacing="-5">404</text>
            </svg>
          </div>

          <div class="not-found-copy">
            <p class="micro-copy">PAGE NOT FOUND · 你访问的页面不存在</p>
            <h1 class="not-found-title">这条路径上没有内容。</h1>
            <p class="not-found-body-text">
              链接可能已过期，或者你打错了地址。<br />
              回首页看看，或者直接联系我。
            </p>
            <div class="not-found-actions">
              <a class="button primary-button" href="/">
                回到首页 <span class="arrow">→</span>
              </a>
              <a class="button" href="/#contact">
                联系我
              </a>
            </div>
          </div>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-card {
    grid-column: 1 / -1;
    background: #ffffff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.82), 0 9px 24px rgba(12,14,18,.045);
    padding: 0;
  }

  .not-found-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 32px;
    padding: 32px;
    align-items: center;
  }

  .not-found-scene {
    aspect-ratio: 2 / 1;
    width: 100%;
    max-width: 380px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: linear-gradient(135deg, #d4e1ff 0%, #c8d4ff 50%, #b9b3f3 100%);
    overflow: hidden;
  }

  .not-found-scene svg {
    width: 100%;
    height: 100%;
  }

  .not-found-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .not-found-title {
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 1;
    color: var(--ink);
  }

  .not-found-body-text {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .not-found-actions {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 767px) {
    .not-found-body {
      grid-template-columns: 1fr;
      padding: 20px;
    }
    .not-found-actions .button {
      flex: 1;
      justify-content: center;
    }
  }
</style>